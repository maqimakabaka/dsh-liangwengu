{
  "name": "dsh-liangwengu",
  "version": "0.3.12",
  "description": "DeepSeek Harness 谷价调度插件：谷价时段自动发送排队指令，支持新建/历史会话、模型与权限选择、峰谷定价、余额告警、记账本与中英双语",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "off-peak",
    "scheduler"
  ],
  "type": "module",
  "main": "lib/index.js",
  "author": "maqimakabaka",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maqimakabaka/dsh-LiangWenGu.git"
  },
  "homepage": "https://github.com/maqimakabaka/dsh-LiangWenGu#readme",
  "bugs": {
    "url": "https://github.com/maqimakabaka/dsh-LiangWenGu/issues"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  }
}
